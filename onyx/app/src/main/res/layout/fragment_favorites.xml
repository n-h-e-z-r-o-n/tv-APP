<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/transparentEffect">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/favoritesSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/transparentEffect">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/transparentEffect">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                android:id="@+id/favoritesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginVertical="10dp"
                android:fontFamily="@font/q"
                android:text="My Favorites"
                android:textColor="?attr/FG_color"
                android:textSize="28sp"
                tools:ignore="HardcodedText" />


                <TextView
                    android:id="@+id/favoritesCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginEnd="10dp"
                    android:layout_marginVertical="10dp"
                    android:fontFamily="@font/o"
                    tools:text="22"
                    android:shadowColor="?attr/AccentColor"
                    android:shadowRadius="1"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:textColor="?attr/FG_color"
                    android:textSize="28sp"
                    tools:ignore="HardcodedText" />

            </FrameLayout>



            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/favoritesRecycler"
                android:layout_marginHorizontal="0dp"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:clipToPadding="true"
                android:scrollbars="none"
                tools:ignore="RtlSymmetry"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/emptyStateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your watchlist is empty."
        android:textColor="?attr/FG_color"
        android:textSize="18sp"
        android:visibility="gone"
        tools:ignore="HardcodedText" />


</FrameLayout>
