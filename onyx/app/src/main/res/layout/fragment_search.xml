<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="horizontal"
    tools:context=".SearchFragment">


        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="70dp"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="30dp"
                android:background="?attr/transparentEffect"
                android:orientation="horizontal"
                android:focusableInTouchMode="true">


                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_anime_filter"
                    app:tint="?attr/AccentColor"
                    android:padding="2dp"
                    android:background="?attr/transparentEffect"
                    android:layout_gravity="center_vertical"
                    tools:ignore="ContentDescription" />


                <!-- Search Text Input -->



                <EditText
                    android:id="@+id/AnimeSearchInput"
                    android:layout_width="250dp"
                    android:layout_height="match_parent"
                    android:hint="Search for anime..."
                    android:textColor="?attr/FG_color"
                    android:textColorHint="?attr/FG_color"
                    android:padding = "3dp"
                    android:inputType="text"
                    android:textSize="15sp"
                    android:singleLine="true"
                    android:clickable="false"
                    android:focusable="false"
                    android:fontFamily="@font/p"
                    android:focusableInTouchMode="true"
                    android:background="?attr/transparentEffect"
                    android:imeOptions="actionSearch"
                    tools:ignore="Autofill,HardcodedText" />

            </LinearLayout>

            <include layout="@layout/keyboard_layout"/>

        </LinearLayout>







        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <TextView
                android:id="@+id/searchTextDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Anime Search Results"
                android:textStyle="bold"
                android:fontFamily="@font/n"                            android:textSize="20sp"
                android:paddingStart="10dp"
                android:textColor="#FFFFFF"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                tools:ignore="HardcodedText,RtlSymmetry"
                android:layout_marginTop="7dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="490dp"
                android:descendantFocusability="afterDescendants"
                >

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/SearchRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:scrollbars="none"
                    android:layout_margin="4dp"
                    tools:ignore="NestedWeights"

                    />
            </LinearLayout>
        </LinearLayout>


</LinearLayout>