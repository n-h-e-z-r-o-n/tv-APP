<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/transparentEffect"
    android:orientation="horizontal"
    tools:context=".SearchFragment">


    <LinearLayout
        android:layout_width="270dp"
        android:layout_height="match_parent"
        android:background="?attr/transparentEffect"
        android:orientation="vertical"
        tools:ignore="TextSizeCheck">


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            tools:ignore="UselessParent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="Search"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />


            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/searchCategoryToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                app:checkedButton="@+id/btnAnime"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnime"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Anime"
                    android:textColor="?attr/FG_color"
                    app:backgroundTint="@color/toggle_background"
                    app:strokeColor="@color/card_stroke"
                    tools:ignore="HardcodedText,TextContrastCheck" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNormalShows"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Normal Shows"
                    android:textColor="?attr/FG_color"
                    app:backgroundTint="@color/toggle_background"
                    app:strokeColor="@color/card_stroke"
                    tools:ignore="HardcodedText" />

            </com.google.android.material.button.MaterialButtonToggleGroup>


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#000000"
                app:cardCornerRadius="6dp"
                app:strokeColor="?attr/AccentColor"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:background="?attr/AccentColor" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/searchView"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:clickable="false"
                        android:focusable="false"
                        android:focusableInTouchMode="true"
                        android:fontFamily="@font/p"
                        android:hint="Search for anime..."
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:padding="10dp"
                        android:singleLine="true"
                        android:textColor="?attr/FG_color"
                        android:textColorHint="?attr/FG_color"
                        android:textSize="15sp"
                        tools:ignore="Autofill,HardcodedText,TouchTargetSizeCheck" />



                    <ImageButton
                        android:id="@+id/btnVoiceSearch"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_btn_speak_now"
                        android:contentDescription="Voice Search"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/searchView"
                        app:tint="@color/image_focus"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <include layout="@layout/keyboard_layout" />


        </LinearLayout>

    </LinearLayout>





       <androidx.core.widget.NestedScrollView
           android:layout_width="0dp"
           android:layout_height="match_parent"
           android:layout_weight="1">



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/recentSearchesLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recent Searches"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="serif" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/recentSearchesContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <TextView
                android:id="@+id/searchTextDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="serif"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="Search Results"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText,RtlSymmetry,TextContrastCheck" />

            <ProgressBar
                android:id="@+id/searchProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:indeterminateTint="?attr/AccentColor"
                android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/SearchRecyclerAnime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:scrollbars="none"
                    tools:ignore="NestedWeights"
                    />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/SearchRecyclerShows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:scrollbars="none"
                    tools:ignore="NestedWeights"
                    />
        </LinearLayout>
       </androidx.core.widget.NestedScrollView>


</LinearLayout>