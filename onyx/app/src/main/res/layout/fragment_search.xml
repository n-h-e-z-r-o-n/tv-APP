<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/transparentEffect"
    android:orientation="horizontal"
    tools:context=".SearchFragment">


        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:background="?attr/transparentEffect"
            android:orientation="vertical">



            <LinearLayout
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                tools:ignore="UselessParent">

                  <TextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="Search"
                      android:textColor="#FFFFFF"
                      android:fontFamily="serif"
                      android:textStyle="bold"
                      android:textSize="40sp"
                      tools:ignore="HardcodedText" />


                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/searchCategoryToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    app:singleSelection="true"
                    app:checkedButton="@+id/btnAnime">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAnime"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Anime"
                        android:textColor="?attr/FG_color"
                        app:strokeColor="@color/card_stroke"
                        tools:ignore="HardcodedText" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNormalShows"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Normal Shows"
                        android:textColor="?attr/FG_color"
                        app:strokeColor="@color/card_stroke"
                        tools:ignore="HardcodedText" />

                </com.google.android.material.button.MaterialButtonToggleGroup>


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginHorizontal="4dp"
                        app:strokeWidth="0dp"
                        app:cardCornerRadius="6dp"
                        app:strokeColor="?attr/AccentColor"
                        android:layout_marginBottom="20dp"
                        app:cardBackgroundColor="#000000">

                        <LinearLayout
                            android:alpha="0"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/AccentColor"/>



                        <EditText
                            android:id="@+id/searchView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:hint="Search for anime..."
                            android:textColor="?attr/FG_color"
                            android:textColorHint="?attr/FG_color"
                            android:padding = "10dp"
                            android:inputType="text"
                            android:textSize="15sp"
                            android:singleLine="true"
                            android:clickable="false"
                            android:focusable="false"
                            android:fontFamily="@font/p"
                            android:focusableInTouchMode="true"
                            android:background="@android:color/transparent"
                            android:imeOptions="actionSearch"
                            tools:ignore="Autofill,HardcodedText" />

                    </com.google.android.material.card.MaterialCardView>

                    <include layout="@layout/keyboard_layout"/>



            </LinearLayout>

        </LinearLayout>





       <androidx.core.widget.NestedScrollView
           android:layout_width="0dp"
           android:layout_height="match_parent"
           android:layout_weight="1">



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/searchTextDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Search Results"
                android:textStyle="bold"
                android:fontFamily="serif"                            android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                tools:ignore="HardcodedText,RtlSymmetry"
                android:layout_marginTop="7dp"/>



                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/SearchRecyclerAnime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:scrollbars="none"
                    tools:ignore="NestedWeights"
                    />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/SearchRecyclerShows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:scrollbars="none"
                    tools:ignore="NestedWeights"
                    />
        </LinearLayout>
       </androidx.core.widget.NestedScrollView>


</LinearLayout>