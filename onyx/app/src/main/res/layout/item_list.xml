<!-- res/layout/item_grid.xml -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="100dp"
    android:layout_height="150dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:layout_margin="5dp"
    android:orientation="vertical"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="2dp"
    card_view:cardBackgroundColor="#90000000"
    android:foreground="@drawable/card_focus"
    android:id="@+id/itemFilter">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#90000000">


        <ImageView
            android:id="@+id/itemImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/transparentEffect"
            android:scaleType="fitXY"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="horizontal">


            <androidx.cardview.widget.CardView
                android:layout_width="43dp"
                android:layout_height="15dp"
                app:cardCornerRadius="4dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="?attr/transparentEffect"
                android:layout_marginStart="5dp"
                android:layout_marginTop="10dp"
                >
                <TextView
                    android:id="@+id/itemText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/transparentEffect"
                    android:ellipsize="end"
                    android:text="2015"
                    android:gravity="center"
                    android:padding="1dp"
                    android:rotationX="0"
                    android:fontFamily="@font/p"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    tools:ignore="HardcodedText,SmallSp" />

            </androidx.cardview.widget.CardView>



            <TextView
                android:id="@+id/showRating"
                android:layout_width="wrap_content"
                android:layout_height="15dp"
                android:layout_marginStart="5dp"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="7.5 imdb"
                android:textColor="#FFFFFF"
                android:textSize="6sp"
                android:fontFamily="@font/p"
                tools:ignore="HardcodedText,SmallSp"
                android:paddingEnd="5dp"
                android:paddingStart="5dp"
                />

            <TextView
                android:id="@+id/showRS"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:layout_marginTop="10dp"
                android:layout_height="15dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="⏱145 min"
                android:textColor="?attr/FG_color"
                android:textSize="7sp"
                android:fontFamily="@font/o"
                tools:ignore="HardcodedText,SmallSp"
                android:paddingEnd="5dp"
                android:paddingStart="5dp"
                android:gravity="center|end"
                />
        </LinearLayout>







        <!-- 🔥 Focus Overlay -->
        <LinearLayout
            android:id="@+id/focusOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:gravity="bottom"
            android:visibility="gone"
            android:paddingBottom="2dp"
            android:paddingTop="14dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            >
        </LinearLayout>

        <TextView
            android:id="@+id/showTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@android:color/transparent"
            android:ellipsize="end"
            android:text="Tekdss"
            android:fontFamily="@font/p"
            android:padding="8dp"
            android:rotationX="0"
            android:singleLine="true"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="4"
            android:shadowRadius="4"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:visibility="gone"/>

        <TextView
            android:visibility="gone"
            android:id="@+id/showType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:ellipsize="end"
            android:text="movie"
            android:fontFamily="@font/a"
            android:gravity="center"
            android:padding="1dp"
            android:alpha="0.7"
            android:rotationX="0"
            android:singleLine="true"
            android:textColor="?attr/FG_color"
            android:textSize="9sp"
            tools:ignore="HardcodedText,SmallSp" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

    </LinearLayout>

</androidx.cardview.widget.CardView>




