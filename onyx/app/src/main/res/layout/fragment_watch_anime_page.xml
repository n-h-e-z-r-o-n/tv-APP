<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/BG_color"
    tools:context=".WatchAnimeFragment">

    <ScrollView
        android:id="@+id/mainBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:background="?attr/BG_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:id="@+id/mainSection"
            android:layout_height="500dp">



            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="150dp"
                android:layout_marginBottom="100dp">

                <ImageView
                    android:id="@+id/backdropWidget"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:src="@raw/background_3"
                    tools:ignore="ContentDescription,ImageContrastCheck" />

                <LinearLayout
                    android:id="@+id/blurContainerLeft"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="@drawable/overlay_left_gradient_bg"
                    android:orientation="vertical"
                    android:gravity="center"/>

                <LinearLayout
                    android:id="@+id/blurContainerBottom"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/overlay_bottom_gradient_bg"
                    android:layout_gravity="bottom"
                    android:orientation="horizontal" />

            </FrameLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="15dp"
                        android:layout_marginBottom="10dp"
                        android:layout_gravity="bottom"
                        android:orientation="horizontal">


                        <LinearLayout
                            android:layout_width="500dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            tools:ignore="TextSizeCheck">


                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/cShowLogo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="150dp"
                                    android:adjustViewBounds="true"
                                    android:maxWidth="400dp"
                                    android:maxHeight="170dp"
                                    android:scaleType="fitXY"
                                    tools:ignore="ContentDescription" />

                            </LinearLayout>


                            <TextView
                                android:id="@+id/watchTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/p"
                                android:maxLines="2"
                                android:shadowColor="#000000"
                                android:shadowDx="2"
                                android:shadowDy="2"
                                android:shadowRadius="3"
                                android:textColor="#FFFFFF"
                                android:textSize="40sp"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText"
                                tools:text="Campfire Cooking in Another World with My Absurd Skill Season 2" />

                            <TextView
                                android:id="@+id/watchGenres"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="serif"
                                android:shadowColor="#000000"
                                android:shadowDx="5"
                                android:shadowDy="6"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                tools:ignore="HardcodedText,SmallSp"
                                tools:text="Adventure ~ Drama ~ Fantasy" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical">


                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="25dp"
                                    android:layout_marginTop="5dp"
                                    android:orientation="horizontal"
                                    android:padding="3dp"
                                    tools:ignore="TextSizeCheck">

                                    <androidx.cardview.widget.CardView
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="center_horizontal"
                                        android:clipToPadding="true"
                                        app:cardCornerRadius="3dp"
                                        app:cardElevation="0dp"
                                        app:cardUseCompatPadding="false"
                                        tools:ignore="TooDeepLayout">

                                        <TextView
                                            android:id="@+id/watchRating"
                                            android:layout_width="wrap_content"
                                            android:layout_height="match_parent"
                                            android:layout_gravity="center"
                                            android:layout_marginHorizontal="4dp"
                                            android:ellipsize="end"
                                            android:fontFamily="@font/p"
                                            android:gravity="center"
                                            android:maxLines="1"
                                            android:paddingHorizontal="4dp"
                                            android:shadowColor="#000000"
                                            android:shadowDx="2"
                                            android:shadowDy="2"
                                            android:shadowRadius="3"
                                            android:singleLine="true"
                                            android:textColor="@android:color/white"
                                            android:textSize="15sp"
                                            android:textStyle="bold"
                                            tools:ignore="HardcodedText,SmallSp,Suspicious0dp,TooDeepLayout,TextContrastCheck"
                                            tools:text="PG-13" />

                                    </androidx.cardview.widget.CardView>


                                    <androidx.cardview.widget.CardView
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="center_horizontal"
                                        android:layout_marginStart="5dp"
                                        app:cardCornerRadius="3dp"
                                        app:cardElevation="0dp"
                                        app:cardUseCompatPadding="false">

                                        <TextView
                                            android:id="@+id/watchQuality"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:layout_marginHorizontal="4dp"
                                            android:ellipsize="end"
                                            android:fontFamily="@font/p"
                                            android:gravity="center"
                                            android:maxLines="1"
                                            android:paddingHorizontal="4dp"
                                            android:shadowColor="#000000"
                                            android:shadowDx="2"
                                            android:shadowDy="2"
                                            android:shadowRadius="3"
                                            android:singleLine="true"
                                            android:textColor="#FFFFFF"
                                            android:textSize="15sp"
                                            tools:ignore="HardcodedText,Suspicious0dp,TextContrastCheck"
                                            tools:text="HD" />

                                    </androidx.cardview.widget.CardView>


                                    <androidx.cardview.widget.CardView
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="center_horizontal"
                                        android:layout_marginStart="5dp"
                                        android:clipToPadding="true"
                                        app:cardCornerRadius="3dp"
                                        app:cardElevation="0dp"
                                        app:cardUseCompatPadding="false">

                                        <TextView
                                            android:id="@+id/watchRuntime"
                                            android:layout_width="wrap_content"
                                            android:layout_height="match_parent"
                                            android:layout_gravity="bottom"
                                            android:ellipsize="end"
                                            android:fontFamily="@font/n"
                                            android:gravity="center"
                                            android:maxLines="1"
                                            android:paddingHorizontal="10dp"
                                            android:shadowColor="#000000"
                                            android:shadowDx="2"
                                            android:shadowDy="2"
                                            android:shadowRadius="3"
                                            android:singleLine="false"
                                            android:textColor="#FFFFFF"
                                            android:textSize="15sp"
                                            tools:ignore="HardcodedText,SmallSp,Suspicious0dp,TextContrastCheck"
                                            tools:text="24m" />
                                    </androidx.cardview.widget.CardView>


                                    <androidx.cardview.widget.CardView
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="center_horizontal"
                                        android:layout_marginStart="5dp"
                                        android:clipToPadding="true"
                                        app:cardCornerRadius="3dp"
                                        app:cardElevation="0dp"
                                        app:cardUseCompatPadding="false">

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:layout_gravity="center"
                                            android:gravity="center"
                                            android:orientation="horizontal"
                                            android:paddingHorizontal="2dp"
                                            tools:ignore="UseCompoundDrawables">


                                            <ImageView
                                                android:layout_width="20dp"
                                                android:layout_height="match_parent"
                                                android:scaleType="centerCrop"
                                                android:src="@drawable/ic_sub"
                                                app:tint="?attr/AccentColor"
                                                tools:ignore="ContentDescription,TooDeepLayout,ImageContrastCheck" />

                                            <TextView
                                                android:id="@+id/watchSub"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_gravity="center"
                                                android:ellipsize="end"
                                                android:fontFamily="@font/p"
                                                android:gravity="center"
                                                android:maxLines="1"
                                                android:paddingHorizontal="2dp"
                                                android:shadowColor="#000000"
                                                android:shadowDx="2"
                                                android:shadowDy="2"
                                                android:shadowRadius="3"
                                                android:singleLine="true"
                                                android:textColor="#FFFFFF"
                                                android:textSize="15sp"
                                                tools:ignore="HardcodedText,SmallSp,Suspicious0dp,TextContrastCheck"
                                                tools:text="23" />
                                        </LinearLayout>
                                    </androidx.cardview.widget.CardView>


                                    <androidx.cardview.widget.CardView
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="center_horizontal"
                                        android:layout_marginStart="5dp"
                                        android:clipToPadding="true"
                                        app:cardCornerRadius="3dp"
                                        app:cardElevation="0dp"
                                        app:cardUseCompatPadding="false">

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:layout_gravity="center"
                                            android:gravity="center"
                                            android:orientation="horizontal"
                                            android:paddingHorizontal="5dp"
                                            tools:ignore="UseCompoundDrawables">

                                            <ImageView
                                                android:layout_width="12dp"
                                                android:layout_height="match_parent"
                                                android:src="@drawable/ic_dub"
                                                app:tint="?attr/AccentColor"
                                                tools:ignore="ContentDescription,ImageContrastCheck" />

                                            <TextView
                                                android:id="@+id/watchDub"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_gravity="center"
                                                android:ellipsize="end"
                                                android:fontFamily="@font/p"
                                                android:gravity="center"
                                                android:maxLines="1"
                                                android:paddingHorizontal="2dp"
                                                android:shadowColor="#000000"
                                                android:shadowDx="2"
                                                android:shadowDy="2"
                                                android:shadowRadius="3"
                                                android:singleLine="true"
                                                android:textColor="#FFFFFF"
                                                android:textSize="15sp"
                                                tools:ignore="HardcodedText,SmallSp,Suspicious0dp,TextContrastCheck"
                                                tools:text="43" />

                                        </LinearLayout>
                                    </androidx.cardview.widget.CardView>

                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="center"
                                        android:layout_marginHorizontal="5dp"
                                        android:alpha="0.3"
                                        android:background="@android:color/darker_gray"
                                        android:gravity="center"
                                        android:textSize="20sp" />

                                    <TextView
                                        android:id="@+id/watchType"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:ellipsize="end"
                                        android:fontFamily="@font/n"
                                        android:gravity="center"
                                        android:maxLines="1"
                                        android:paddingHorizontal="2dp"
                                        android:shadowColor="#000000"
                                        android:shadowDx="2"
                                        android:shadowDy="2"
                                        android:shadowRadius="3"
                                        android:singleLine="true"
                                        android:textColor="#FFFFFF"
                                        android:textSize="15sp"
                                        tools:ignore="HardcodedText,SmallSp,Suspicious0dp"
                                        tools:text="Tv" />

                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="center"
                                        android:layout_marginHorizontal="5dp"
                                        android:alpha="0.3"
                                        android:background="@android:color/darker_gray"
                                        android:gravity="center"
                                        android:textSize="20sp" />


                                    <TextView
                                        android:id="@+id/watchYear"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="bottom"
                                        android:layout_marginStart="9dp"
                                        android:ellipsize="end"
                                        android:fontFamily="@font/n"
                                        android:gravity="center"
                                        android:maxLines="1"
                                        android:paddingHorizontal="2dp"
                                        android:shadowColor="#000000"
                                        android:shadowDx="2"
                                        android:shadowDy="2"
                                        android:shadowRadius="3"
                                        android:singleLine="false"
                                        android:text=""
                                        android:textColor="#FFFFFF"
                                        android:textSize="18sp"
                                        tools:ignore="HardcodedText,SmallSp,Suspicious0dp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/watchOverview"
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_marginTop="10dp"
                                    android:layout_marginBottom="10dp"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:fontFamily="serif"
                                    android:maxLines="3"
                                    android:shadowColor="#000000"
                                    android:shadowDx="2"
                                    android:shadowDy="2"
                                    android:shadowRadius="3"
                                    android:textColor="#FFFFFF"
                                    android:textSize="13sp"
                                    tools:ignore="NestedWeights,SmallSp"
                                    tools:text="The fourth season of Tensei Shitara Slime Datta Ken. Demon Lord Rimuru's dream of creating an alliance between humans and monsters takes a step closer to being realized. As Tempest continues to prosper, Granville Rozzo and his granddaughter, Maribel Rozzo, clash with Demon Lord Rimuru over their plan to protect mankind by ruling over them. Meanwhile, in El Dorado, Demon Lord Leon works toward goals of his own. The awakening of a new Hero draws near! " />

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/favoriteButtonAnime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom"
                                    android:clickable="true"
                                    android:focusable="true"
                                    app:cardBackgroundColor="#40FFFFFF"
                                    app:cardCornerRadius="9dp"
                                    app:cardElevation="0dp"
                                    app:strokeColor="@color/card_stroke"
                                    app:strokeWidth="2dp"
                                    tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck">


                                    <ImageView
                                        android:id="@+id/favoriteButtonImg"
                                        android:layout_width="24dp"
                                        android:layout_height="34dp"
                                        android:layout_marginHorizontal="14dp"
                                        android:background="@android:color/transparent"
                                        android:src="@drawable/ic_addfave"
                                        android:textAllCaps="false"
                                        android:textColor="?attr/FG_color"
                                        android:tooltipText="Add to Favorites"
                                        app:tint="#FFFFFF"
                                        tools:ignore="ContentDescription,UnusedAttribute" />


                                </com.google.android.material.card.MaterialCardView>
                            </LinearLayout>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/WatchImage"
                            android:layout_gravity="end"
                            android:layout_width="150dp"
                            android:layout_height="225dp"
                            android:layout_marginTop="20dp"
                            android:scaleType="fitXY"
                            android:elevation="15dp"
                            tools:src="@raw/anime_poster"
                            tools:ignore="ContentDescription,ImageContrastCheck" />
                    </FrameLayout>



                    <TextView
                        android:id="@+id/SeasonHeadline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="seasons"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="15dp"
                        android:shadowColor="#000000"
                        android:alpha="0.6"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="3"
                        android:paddingHorizontal="5dp"
                        android:textSize="20sp"
                        android:visibility="visible"
                        android:fontFamily="@font/p"
                        tools:ignore="HardcodedText" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                                <HorizontalScrollView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clipToPadding="false"
                                    android:scrollbars="none"
                                    tools:ignore="SpeakableTextPresentCheck">

                                    <LinearLayout
                                        android:id="@+id/anime_season_selector_container"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        />
                                </HorizontalScrollView>

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="?attr/AccentColor"
                                    android:alpha="0.3" />

                                <TextView
                                    android:id="@+id/selected_seasonShow"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    tools:text="List of episodes (witch hat Atelier)"
                                    android:textColor="#FFFFFF"
                                    android:layout_marginStart="15dp"
                                    android:shadowColor="#000000"
                                    android:shadowDx="2"
                                    android:shadowDy="2"
                                    android:shadowRadius="3"
                                    android:paddingHorizontal="2dp"
                                    android:textSize="12sp"
                                    android:alpha="0.6"
                                    android:fontFamily="serif"
                                    tools:ignore="HardcodedText" />

                                <HorizontalScrollView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:scrollbars="none">
                                    <LinearLayout
                                        android:id="@+id/anime_episodes_selector_container"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"/>
                                </HorizontalScrollView>
                    </LinearLayout>

            </LinearLayout>

        </FrameLayout>

        <LinearLayout
            android:id="@+id/showMore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Recommended  Animes"
                    android:fontFamily="@font/q"
                    android:layout_marginStart="20dp"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp"
                    android:textColor="?attr/FG_color"
                    tools:ignore="HardcodedText" />


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/animeWatchRecommendation"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:padding="10dp"
                    android:scrollbars="none"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:descendantFocusability="afterDescendants"
                    android:nestedScrollingEnabled="false"
                    tools:ignore="RtlSymmetry"/>

        </LinearLayout>



    </LinearLayout>

    </ScrollView>

    <include layout="@layout/laod_animation"/>

</androidx.constraintlayout.widget.ConstraintLayout>