<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingVertical="6dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/profileCardContiner"
        android:layout_width="156dp"
        android:layout_height="192dp"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:foreground="@drawable/login_profile_focus"
        card_view:cardBackgroundColor="#25171C24"
        card_view:cardCornerRadius="22dp"
        card_view:cardElevation="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/itemUserAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#20000000" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/overlay_bottom_gradient_bg" />

            <TextView
                android:id="@+id/itemProfileMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/login_settings_pill"
                android:fontFamily="@font/n"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="PROFILE"
                android:textAllCaps="true"
                android:textColor="#FFF8EE"
                android:textSize="10sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/itemProfileCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="16dp"
                android:alpha="0.74"
                android:fontFamily="@font/n"
                android:text="Continue"
                android:textColor="#FFF8EE"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/itemUsername"
        android:layout_width="164dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:visibility="gone"
        android:fontFamily="@font/p"
        android:gravity="center"
        android:maxLines="1"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:text="Hezron"
        android:textColor="#FFF8EE"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />

</LinearLayout>
