                    <!-- //////////////////////// ANIME FAVORITE PAGE ////////////////////////////////////// -->
                    <LinearLayout
                        android:id="@+id/FavPageAnime"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:visibility="gone">



                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Favorite List"
                            android:textStyle="bold"
                            android:fontFamily="@font/p"
                            android:textSize="13sp"
                            android:textColor="?attr/FG_color"
                            tools:ignore="HardcodedText"
                            android:alpha="0.5"
                            android:layout_marginTop="10dp"/>


                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginVertical="10dp"
                            app:cardBackgroundColor="?attr/BG_color"
                            app:cardCornerRadius="20dp"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="end">

                                <ImageView
                                    android:id="@+id/FavBackdrop"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:adjustViewBounds="true"
                                    android:scaleType="fitCenter"
                                    android:src="@raw/anime_poster"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent" />

                                <!-- Bottom Gradient Overlay: covers 30% of height -->
                                <View
                                    android:id="@+id/BottomOverlay"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:background="@drawable/overlay_bottom_gradient_bg"

                                    app:layout_constraintBottom_toBottomOf="@id/FavBackdrop"
                                    app:layout_constraintStart_toStartOf="@id/FavBackdrop"
                                    app:layout_constraintEnd_toEndOf="@id/FavBackdrop"
                                    app:layout_constraintHeight_percent="0.35" />

                                <!-- Left Gradient Overlay: covers 25% of width -->
                                <View
                                    android:id="@+id/LeftOverlay"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:background="@drawable/overlay_left_gradient_bg"
                                    app:layout_constraintStart_toStartOf="@id/FavBackdrop"
                                    app:layout_constraintTop_toTopOf="@id/FavBackdrop"
                                    app:layout_constraintBottom_toBottomOf="@id/FavBackdrop"
                                    app:layout_constraintWidth_percent="0.40" />

                            </androidx.constraintlayout.widget.ConstraintLayout>


                            <LinearLayout
                                android:id="@+id/FaveData"
                                android:layout_width="450dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="bottom"
                                android:gravity="bottom"
                                android:layout_marginStart="10dp"
                                android:layout_marginBottom="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/FavTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom"
                                    android:ellipsize="end"
                                    android:maxLines="3"
                                    android:text="Sakamoto Days Part 2"
                                    android:singleLine="false"
                                    android:textColor="?attr/FG_color"
                                    android:textSize="40sp"
                                    android:textStyle="bold"
                                    android:layout_marginBottom="5dp"
                                    android:fontFamily="@font/p"
                                    tools:ignore="HardcodedText" />
                                <TextView
                                    android:id="@+id/FavGenre"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="Action"
                                    android:singleLine="false"
                                    android:textColor="?attr/FG_color"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:layout_marginBottom="10dp"
                                    android:fontFamily="@font/q"
                                    tools:ignore="HardcodedText" />
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="20dp"
                                    android:orientation="horizontal"
                                    android:layout_marginBottom="10dp"
                                    android:alpha="0.5">

                                    <TextView
                                        android:id="@+id/FavType"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="bottom"
                                        android:ellipsize="end"
                                        android:maxLines="7"
                                        android:text=""
                                        android:singleLine="false"
                                        android:textColor="?attr/AccentColor"
                                        android:textSize="15sp"
                                        android:fontFamily="@font/a"
                                        android:gravity="center"
                                        android:textStyle="bold"
                                        android:layout_marginEnd="15dp"
                                        />

                                    <androidx.cardview.widget.CardView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        app:cardCornerRadius="3dp"
                                        android:text="IMDB"

                                        android:textSize="11sp"
                                        app:cardBackgroundColor="#DAA520"
                                        tools:ignore="HardcodedText"
                                        android:textStyle="bold">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="IMDb"
                                            android:paddingVertical="2dp"
                                            android:paddingHorizontal="5dp"
                                            android:textColor="#000000"
                                            android:textStyle="bold"
                                            android:textSize="11sp"
                                            android:fontFamily="@font/p"
                                            tools:ignore="HardcodedText" />

                                    </androidx.cardview.widget.CardView>

                                    <TextView
                                        android:id="@+id/FavRating"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="bottom"
                                        android:ellipsize="end"
                                        android:maxLines="7"
                                        android:text=""
                                        android:singleLine="false"
                                        android:textColor="?attr/FG_color"
                                        android:textSize="13sp"
                                        android:gravity="center"
                                        android:textStyle="italic|bold"
                                        android:layout_marginEnd="15dp"
                                        android:layout_marginStart="2dp"
                                        />
                                    <TextView
                                        android:id="@+id/FavYear"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="bottom"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:text=""
                                        android:singleLine="false"
                                        android:textColor="?attr/FG_color"
                                        android:textSize="13sp"
                                        android:gravity="center"
                                        android:textStyle="italic|bold"
                                        android:layout_marginEnd="15dp"
                                        />





                                </LinearLayout>

                                <TextView
                                    android:id="@+id/FavOverview"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom"
                                    android:ellipsize="end"
                                    android:maxLines="5"
                                    android:singleLine="false"
                                    android:text="  at com.android.server.wm.WindowOrganizerController.onTransact(WindowOrganizerController.java:223)"
                                    android:textColor="?attr/FG_color"
                                    android:fontFamily="@font/p"
                                    android:textSize="12sp"
                                    android:layout_marginBottom="20dp"
                                    />

                                <LinearLayout
                                    android:id="@+id/RemoveFaveItem"
                                    android:layout_width="wrap_content"
                                    android:layout_height="30dp"
                                    android:focusable="true"
                                    android:focusableInTouchMode="true"
                                    android:clickable="true"
                                    android:background="@drawable/watch_button"
                                    android:nextFocusLeft="@+id/sideBar"
                                    android:paddingStart="9dp"
                                    android:paddingEnd="9dp"
                                    android:gravity="center">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:contentDescription="TODO"
                                        android:src="@drawable/remove_fave"
                                        app:tint="?attr/AccentColor"
                                        tools:ignore="ContentDescription,HardcodedText" />



                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Remove From Favorites"
                                        android:textColor="@android:color/white"
                                        android:fontFamily="@font/q"
                                        android:textSize="8sp"
                                        android:layout_marginStart="2dp"
                                        tools:ignore="HardcodedText,SmallSp"
                                        />

                                </LinearLayout>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>



                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/faveRecycler"
                            android:layout_marginHorizontal="0dp"
                            android:layout_height="match_parent"
                            android:layout_width="match_parent"
                            android:clipToPadding="false"
                            android:scrollbars="none"
                            tools:ignore="RtlSymmetry"/>


                    </LinearLayout>

                    <!-- //////////////////////// WATCHLIST PAGE ////////////////////////////////////// -->
                   <LinearLayout
                       android:id="@+id/WatchedListPageAnime"
                       android:layout_width="match_parent"
                       android:layout_height="match_parent"
                       android:orientation="vertical"
                       android:visibility="gone">

                       <TextView
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           android:text="Continue Watching"
                           android:textStyle="bold"
                           android:fontFamily="@font/p"
                           android:textSize="13sp"
                           android:alpha="0.5"
                           android:textColor="#FFFFFF"
                           android:shadowColor="#000000"
                           android:shadowDx="1"
                           android:shadowDy="1"
                           android:shadowRadius="2"
                           tools:ignore="HardcodedText"
                           android:layout_marginTop="10dp"/>

                       <androidx.recyclerview.widget.RecyclerView
                           android:id="@+id/watchingRecycler"
                           android:layout_height="match_parent"
                           android:layout_width="match_parent"
                           android:clipToPadding="false"
                           android:scrollbars="none"
                           tools:ignore="RtlSymmetry"/>

                   </LinearLayout>

                    <!-- //////////////////////// NOTIFICATION  PAGE ////////////////////////////////////// -->
                    <LinearLayout
                        android:id="@+id/notificationPageAnime"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="10dp">

                            <TextView
                                android:id="@+id/notificationHeadline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="notifications"
                                android:textStyle="bold"
                                android:fontFamily="@font/p"
                                android:textSize="13sp"
                                android:alpha="0.5"
                                android:textColor="?attr/FG_color"
                                tools:ignore="HardcodedText"
                                />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"/>

                            <TextView
                                android:id="@+id/clearNotBtn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Clear All"
                                android:textColor="#FFFFFF"
                                android:shadowColor="#000000"
                                android:shadowDx="1"
                                android:shadowDy="1"
                                android:shadowRadius="2"
                                android:paddingHorizontal="15dp"
                                android:paddingVertical="2dp"
                                android:background="@drawable/filter_button"
                                android:layout_marginRight="20dp"
                                tools:ignore="HardcodedText" />

                        </LinearLayout>



                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/notificationRecycler"
                            android:layout_height="match_parent"
                            android:layout_width="match_parent"
                            android:clipToPadding="false"
                            android:scrollbars="none"
                            tools:ignore="RtlSymmetry"/>

                    </LinearLayout>


                </LinearLayout>
            </ScrollView>

        </LinearLayout>

